# Generated distribution artifacts: collapse in diffs and language statistics.
feeds/*.json linguist-generated=true
feeds/*.xml  linguist-generated=true
apps/*/index.html linguist-generated=true

# Published copies of feeds/ at the flat and API URL families. GitHub Pages
# serves this repository from the branch, so the browser/installer-facing URLs
# are the committed files at the root and under api/ — regenerated by
# src/omnisource/site.py, byte-identical to their feeds/ originals.
/apps.json linguist-generated=true
/api/** linguist-generated=true
/catalog.min.json linguist-generated=true
/sitemap.xml linguist-generated=true
/robots.txt linguist-generated=true

# gzip twins of the JSON API documents.
*.json.gz binary

# RFC 5545 requires CRLF; folded text may preserve spaces at line ends.
*.ics -text whitespace=cr-at-eol,-blank-at-eol
feeds/calendars/*.ics linguist-generated=true
feeds/*.ics linguist-generated=true

# Consistent text files across development platforms.
*.json text eol=lf
*.xml  text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf

# Images must never receive newline conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
