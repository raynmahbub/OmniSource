{
  "name": "omnisource-web",
  "private": true,
  "version": "3.2.0",
  "description": "OmniSource modern website (Next.js 16 + TypeScript + Tailwind PWA)",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "predev": "npm run sync-data",
    "prebuild": "npm run sync-data",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node scripts/test-data.mjs",
    "typecheck": "npm run sync-data && tsc --noEmit",
    "lint": "npm run sync-data && eslint src"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "postcss": "^8.5.28"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
