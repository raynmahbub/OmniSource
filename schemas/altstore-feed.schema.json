{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raynmahbub.github.io/OmniSource/schemas/feed.schema.json",
  "title": "AltStore Source v2",
  "description": "Structural schema for the AltStore-compatible feeds published by OmniSource from feeds/*.json. Unknown extension keys (e.g. `omnisource`, `fallbackDownloadURLs`) are permitted: AltStore-family clients ignore what they do not understand.",
  "type": "object",
  "required": ["name", "identifier", "apps"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "identifier": { "type": "string", "minLength": 1 },
    "apiVersion": { "type": "string" },
    "subtitle": { "type": "string" },
    "description": { "type": "string" },
    "iconURL": { "type": "string", "format": "uri" },
    "bannerURL": { "type": "string", "format": "uri" },
    "headerURL": { "type": "string", "format": "uri" },
    "tintColor": { "$ref": "#/definitions/hexColor" },
    "website": { "type": "string", "format": "uri" },
    "sourceURL": { "type": "string", "format": "uri" },
    "userInfo": { "type": "object", "additionalProperties": true },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/app" }
    },
    "news": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "identifier", "date"],
        "additionalProperties": true
      }
    }
  },
  "definitions": {
    "hexColor": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{6}$"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([Tt ][0-9]{2}:[0-9]{2}(:[0-9]{2})?(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:?[0-9]{2})?)?$"
    },
    "fallbackDownloadURLs": {
      "type": "array",
      "description": "Ordered mirror URLs for the same build, tried when downloadURL is unavailable.",
      "items": { "type": "string", "format": "uri" },
      "uniqueItems": true
    },
    "appVersion": {
      "type": "object",
      "required": ["version", "date", "localizedDescription", "downloadURL", "size"],
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/definitions/isoDate" },
        "localizedDescription": { "type": "string" },
        "downloadURL": { "type": "string", "format": "uri" },
        "size": { "type": "integer", "minimum": 1 },
        "minOSVersion": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
        "maxOSVersion": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
        "fallbackDownloadURLs": { "$ref": "#/definitions/fallbackDownloadURLs" },
        "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
        "buildVersion": { "type": "string" }
      }
    },
    "app": {
      "type": "object",
      "required": [
        "name",
        "bundleIdentifier",
        "developerName",
        "version",
        "versionDate",
        "localizedDescription",
        "downloadURL",
        "size",
        "iconURL",
        "tintColor",
        "versions"
      ],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "bundleIdentifier": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" },
        "developerName": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "version": { "type": "string", "minLength": 1 },
        "versionDate": { "$ref": "#/definitions/isoDate" },
        "versionDescription": { "type": "string" },
        "localizedDescription": { "type": "string" },
        "downloadURL": { "type": "string", "format": "uri" },
        "size": { "type": "integer", "minimum": 1 },
        "iconURL": { "type": "string", "format": "uri" },
        "tintColor": { "$ref": "#/definitions/hexColor" },
        "category": { "type": "string" },
        "screenshotURLs": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "beta": { "type": "boolean" },
        "patreon": { "type": "boolean" },
        "fallbackDownloadURLs": { "$ref": "#/definitions/fallbackDownloadURLs" },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/appVersion" }
        },
        "permissions": {
          "type": "array",
          "description": "Legacy AltStore permission array.",
          "items": {
            "type": "object",
            "required": ["type", "usageDescription"],
            "additionalProperties": true
          }
        },
        "appPermissions": {
          "type": "object",
          "description": "AltStore 2.0 permission declaration.",
          "additionalProperties": true,
          "properties": {
            "entitlements": { "type": "array", "items": { "type": "string" } },
            "privacy": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      }
    }
  }
}
